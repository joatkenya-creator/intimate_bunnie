# PostgreSQL (Neon-compatible). Pooled connection string for serverless.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 32+ byte random string. Signs session cookies (HMAC-SHA256).
#   openssl rand -base64 32
AUTH_SECRET=""

# Absolute site origin, no trailing slash. Used by canonicals, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Transactional email (Resend). Without the key, sends are logged and skipped —
# every flow still works locally. See docs/EMAIL.md.
RESEND_API_KEY=""
# Must be an address on a domain verified with the provider.
EMAIL_FROM="Intimate Bunnie <care@intimatebunnie.com>"
EMAIL_REPLY_TO="care@intimatebunnie.com"

# ── Admin ───────────────────────────────────────────────────────────────────
# Idle timeout for admin sessions, in minutes. It slides: any admin request past
# the halfway mark re-issues the cookie, so activity extends the session and only
# inactivity ends it. The storefront cookie is unaffected and still lasts 30 days.
#
# Local only — this file is not uploaded. To change it in production either set a
# `vars` entry in wrangler.jsonc or `npx wrangler secret put`.
ADMIN_SESSION_TIMEOUT_MINUTES="60"

# Injected by connecting a Vercel Blob store — never set by hand. Either shape
# works: BLOB_STORE_ID (paired with a runtime VERCEL_OIDC_TOKEN) or a static
# BLOB_READ_WRITE_TOKEN. Without one, media uploads are disabled and the library
# falls back to adding images by URL.
BLOB_STORE_ID=""

# Bearer token for /api/admin/cron. Vercel Cron attaches it automatically once
# the variable exists; scheduled publishing works without one.
CRON_SECRET=""

# Optional analytics. Scripts load only when the ID is present.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Deliberately absent until those services are actually integrated:
# Cloudinary, Klarna, Firecrawl, Upstash Redis.
