{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intimate-bunnie",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare creates the DNS records and certificates for these itself —
  // do not add A/CNAME records by hand.
  "routes": [
    { "pattern": "intimatebunnie.com", "custom_domain": true },
    { "pattern": "www.intimatebunnie.com", "custom_domain": true }
  ],
  // The store is reachable only on the custom domain; the workers.dev
  // subdomain would otherwise serve the same catalog on a second hostname.
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
  // No KV / D1 / Durable Object / Queue bindings — nothing in the current
  // implementation needs them. DATABASE_URL and AUTH_SECRET are set as secrets:
  //   wrangler secret put DATABASE_URL
  //   wrangler secret put AUTH_SECRET
  //
  // Admin media uploads need an R2 bucket. Without it the library still works
  // by URL, and the upload endpoint returns an actionable 501:
  //   "r2_buckets": [
  //     { "binding": "MEDIA_BUCKET", "bucket_name": "intimate-bunnie-media" }
  //   ]
  // …plus MEDIA_PUBLIC_BASE set to the bucket's public hostname.
  //
  // Scheduled publishing rides on middleware's once-a-minute redirect poll. For
  // exact timing and the low-stock sweep, add a cron trigger hitting
  // POST /api/admin/cron with `authorization: Bearer $CRON_SECRET`:
  //   "triggers": { "crons": ["*/5 * * * *"] }
}
